@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Arrow is part of the public API (arrow::Table). Parquet is a private
# dependency, but the exported shared-library target still refers to it.
find_dependency(Arrow)
find_dependency(Parquet)
if(@MSENTITY_HDF5_FROM_CONFIG@)
  find_dependency(hdf5 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/msentityTargets.cmake")
check_required_components(msentity)
